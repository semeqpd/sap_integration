APP_NAME="SEMEQ Middleware"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Banco (MySQL) — externo. O compose não sobe banco nenhum.
#
# Duas formas — escolha UMA:
#
#  1) URL única. Se DB_URL estiver preenchida ela ganha e as variáveis
#     avulsas abaixo são ignoradas. Caracteres especiais da senha precisam
#     ser escapados ('#' vira %23):
#     DB_URL=mysql://usuario:senha@host:3306/sapintegracoes?charset=utf8mb4
#
#  2) Variáveis avulsas. Senha com '#' precisa vir entre aspas.
# ---------------------------------------------------------------------------
DB_URL=
DB_CONNECTION=mysql
DB_HOST=192.168.0.201
DB_PORT=3306
DB_DATABASE=sapintegracoes
DB_USERNAME=sap
DB_PASSWORD=

# Portas expostas no host (diferentes das do PHP_port, para os dois poderem
# rodar ao mesmo tempo)
APP_PORT=8083
ADMINER_PORT=8084

# true = o container migra e seeda sozinho na subida.
# false = você controla migrate/seed na mão.
RUN_MIGRATIONS=false

# ---------------------------------------------------------------------------
# SAP Business One — Service Layer
# ---------------------------------------------------------------------------
SAP_BASE_URL=https://192.168.0.84:50000/b1s/v1
SAP_COMPANY_DB=SEMEQBR2
SAP_USERNAME=cmms
SAP_PASSWORD=
# Service Layer usa certificado self-signed no lab: false ignora a validação
SAP_VERIFY_TLS=false

# De-paras ainda fixos (viram tabela/tela depois)
SAP_ACCOUNT_CODE=3.01.01.01.0001
SAP_ITEM_CODE=10
SAP_TAX_CODE=IVA01
SAP_BRANCH_ID=3

# ---------------------------------------------------------------------------
